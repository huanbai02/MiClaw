# MiClaw 环境配置示例
# 复制为 .env 后填入本地配置，不要提交真实 API key。

DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_BASE_URL=
OPENAI_API_BASE=
ANTHROPIC_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
MICLAW_WORKSPACE=
